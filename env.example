# Required ─────────────────────────────────────────────────────────────────────
# Your Discord bot token. Get this from https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here

# Mermaid rendering ─────────────────────────────────────────────────────────────
# Theme applied to all rendered diagrams.
# Options: default | dark | forest | neutral | base
MERMAID_THEME=default

# Background colour for rendered diagrams. Any CSS colour or "transparent".
MERMAID_BACKGROUND=white

# Rate limiting ─────────────────────────────────────────────────────────────────
# Minimum milliseconds between render requests for the same user.
RENDER_COOLDOWN_MS=10000

# Maximum number of diagrams rendered from a single message.
MAX_DIAGRAMS_PER_MESSAGE=3

# Maximum milliseconds to wait for a single render before timing out.
RENDER_TIMEOUT_MS=60000
